# ============================================================
# Samenmakers — Environment Variables
# Copy this file to .env.local and fill in your values.
# ============================================================

# ---- Database (Neon PostgreSQL) ----------------------------
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/samenmakers?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/samenmakers?sslmode=require

# ---- Auth.js v5 --------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-32-char-secret-here

# Google OAuth — https://console.cloud.google.com/
AUTH_GOOGLE_ID=xxxx.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=GOCSPX-xxxx

# LinkedIn OAuth — https://www.linkedin.com/developers/apps
AUTH_LINKEDIN_ID=xxxx
AUTH_LINKEDIN_SECRET=xxxx

# ---- Pusher (real-time) ------------------------------------
# https://dashboard.pusher.com/
PUSHER_APP_ID=1234567
PUSHER_SECRET=your-pusher-secret
NEXT_PUBLIC_PUSHER_KEY=your-pusher-key
NEXT_PUBLIC_PUSHER_CLUSTER=eu

# ---- Stripe ------------------------------------------------
# https://dashboard.stripe.com/
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
STRIPE_PRO_PRICE_ID=price_xxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxx

# ---- Resend (transactional email) --------------------------
# https://resend.com/
RESEND_API_KEY=re_xxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ---- Upstash Redis (rate limiting) -------------------------
# https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxx

# ---- Vercel Blob (file uploads) ----------------------------
# Added automatically when you link Vercel Blob storage.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxx

# ---- Web Push (VAPID) --------------------------------------
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key  (add to env.ts if needed)

# ---- Cron --------------------------------------------------
# Used to authenticate Vercel Cron job requests.
# Generate with: openssl rand -base64 32
CRON_SECRET=your-32-char-cron-secret

# ---- AI (OpenRouter — OpenAI-compatible gateway) -----------
# https://openrouter.ai/  — used for management analysis & AI blog.
OPENROUTER_API_KEY=sk-or-v1-xxxx
# Default model when unset: anthropic/claude-sonnet-4.6
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6

# ---- Management reporting ----------------------------------
# Recipient of the daily/weekly management digest.
MANAGEMENT_EMAIL=v.munster@weareimpact.nl

# ---- App ---------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ---- Build (skip validation during CI) --------------------
# SKIP_ENV_VALIDATION=1
