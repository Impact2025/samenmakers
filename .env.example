# ===========================================
# Samenmakers — Omgevingsvariabelen
# ===========================================
# Kopieer dit bestand naar .env.local en vul alle waarden in.
#
# DATABASE
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# AUTH (NextAuth.js v5)
AUTH_SECRET=                                                  # min. 64 chars — `openssl rand -base64 48`
AUTH_GOOGLE_ID=                                               # Google Cloud OAuth client ID
AUTH_GOOGLE_SECRET=                                           # Google Cloud OAuth client secret
AUTH_LINKEDIN_ID=                                             # LinkedIn App client ID
AUTH_LINKEDIN_SECRET=                                         # LinkedIn App client secret

# PUSHER (real-time chat)
PUSHER_APP_ID=
PUSHER_SECRET=

# STRIPE (abonnementen + coupons)
STRIPE_SECRET_KEY=sk_live_...                                 # Stripe secret key
STRIPE_WEBHOOK_SECRET=whsec_...                               # Stripe webhook signing secret
STRIPE_PRO_PRICE_ID=price_...                                 # Stripe Price ID voor Pro abonnement
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...                       # Optioneel: secret van het Connect-webhookendpoint (account.updated)
EVENT_PLATFORM_FEE_BPS=0                                      # Platformfee op tickets in basispunten (250 = 2,5%)
EVENT_PLATFORM_FEE_FIXED_CENTS=0                              # Plus vast bedrag per betaald ticket, in centen
NEXT_PUBLIC_FEATURE_EVENT_TICKETS=false                       # Tickets aan in productie (buiten productie standaard aan)

# RESEND (e-mail)
RESEND_API_KEY=re_...                                         # Resend API key
RESEND_FROM_EMAIL=samenmakers@voorbeeld.nl                    # Afzenderadres voor e-mails

# UPSTASH (rate limiting)
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io                 # Upstash Redis REST URL
UPSTASH_REDIS_REST_TOKEN=                                     # Upstash Redis REST token

# CRON (job authenticatie)
CRON_SECRET=                                                  # min. 32 chars — gedeeld geheim voor cron endpoints

# AI (OpenRouter — optioneel, voor blog/mail generatie)
OPENROUTER_API_KEY=                                           # OpenRouter API key
OPENROUTER_MODEL=openai/gpt-4o-mini                           # Model override (optioneel)

# MANAGEMENT REPORTING (optioneel)
MANAGEMENT_EMAIL=beheer@voorbeeld.nl                          # Ontvanger van dagelijkse/weekelijkse KPI-rapporten

# PUBLIC (client-side)
NEXT_PUBLIC_APP_URL=http://localhost:3000                     # Volledige app URL (prod: https://samenmakers.nl)
NEXT_PUBLIC_PUSHER_KEY=                                       # Pusher app key (public)
NEXT_PUBLIC_PUSHER_CLUSTER=eu                                 # Pusher cluster
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...                # Stripe publishable key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=                                 # Web Push VAPID public key (generate via web-push)

# ===========================================
# Ontwikkeling (optioneel)
# ===========================================
SKIP_ENV_VALIDATION=true                                      # Sla env-validatie over (voor CI/local)
